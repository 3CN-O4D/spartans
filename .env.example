# ---------------------------------------------------------------------------
# Copy to `.env.local` (development) or set these in your host's dashboard.
# ---------------------------------------------------------------------------

# Password for /login. REQUIRED in production — without it the admin CMS is
# disabled rather than falling back to a public default.
ADMIN_PASSWORD=

# Canonical public URL, used for metadata, robots.txt and sitemap.xml.
# e.g. https://spartansacademy.co.ke
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Vercel Blob storage (required on Vercel)
# ---------------------------------------------------------------------------
# Vercel's filesystem is read-only and ephemeral, so the CMS, form
# submissions and Instagram sync state need Blob storage in production.
#
# Vercel Blob stores have a fixed access mode, so create TWO stores:
#   1. A PUBLIC store for photos. Copy its read-write token here.
#   2. A PRIVATE store for content.json, sync state and form submissions.
#      Copy its read-write token here.
#
# The public token is also used for browser-direct uploads. OIDC alone cannot
# issue client upload tokens, so keep the public read-write token configured.
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Legacy fallback used as the public-image token if the explicit public token
# above is not set. Vercel may create this automatically when you connect a
# Blob store; rename it to BLOB_PUBLIC_READ_WRITE_TOKEN to be explicit.
# BLOB_READ_WRITE_TOKEN=

# Where registration form submissions are delivered.
# Works with Formspree, Zapier, Make, n8n, Slack/Discord webhooks, etc.
# If unset, submissions are appended to data/messages.ndjson on local disk
# (only suitable for hosts with a persistent filesystem, not Vercel).
CONTACT_WEBHOOK_URL=

# Where "support the club" messages are delivered. Falls back to
# CONTACT_WEBHOOK_URL, then to data/support.ndjson on local disk.
SUPPORT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Instagram + TikTok -> website sync (no API keys required)
# ---------------------------------------------------------------------------
# One worker reads Instagram and the other reads the public TikTok embed. Both
# run from the same endpoint and the same admin "Sync socials" button.
INSTAGRAM_USERNAME=spartanssocceracademy
TIKTOK_USERNAME=spartanssocceraca
INSTAGRAM_SYNC_ENABLED=false
# Allow one automatic check per 24 hours when someone visits the home page.
INSTAGRAM_SYNC_PUBLIC=false
INSTAGRAM_MAX_POSTS_PER_RUN=2
# TikTok videos can be large; keep the first automatic run small. Increase it
# for a manual import. Maximum 12 per run.
TIKTOK_MAX_POSTS_PER_RUN=2

# Secret for a cron job or manual curl request. Vercel Cron's CRON_SECRET is
# also accepted. Not needed for the public once-a-day trigger.
SYNC_SECRET=

# Optional: official Instagram Graph API (recommended for reliability).
# Requires an Instagram Business/Creator account linked to a Facebook Page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Optional: AI copy writer. Any OpenAI-compatible endpoint works. If unset,
# the built-in local writer produces the post instead.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

